// by Nisan and Schocken, MIT Press.
// File name: projects/12/Screen.jack

/**
 * A library of functions for displaying graphics on the screen.
 * The Hack physical screen consists of 256 rows (indexed 0..255, top to bottom)
 * and 512 columns (indexed 0..511, left to right). The top left pixel is (0,0).
 * The screen memory map starts at RAM address 16384 and occupies 8192 words.
 * Each row is 32 consecutive 16-bit words (32 * 16 = 512 pixels).
 */
class Screen {
    static boolean color; // true = black, false = white
    static Array twoToThe; // powers of 2 lookup table

    /** Initializes the Screen. */
    function void init() {
        var int i, val;
        let color = true;

        // Build powers-of-2 table
        let twoToThe = Array.new(16);
        let val = 1;
        let i = 0;
        while (i < 16) {
            let twoToThe[i] = val;
            let val = val + val;
            let i = i + 1;
        }
        return;
    }

    /** Erases the entire screen (sets all pixels to white). */
    function void clearScreen() {
        var int i;
        let i = 0;
        while (i < 8192) {
            do Memory.poke(16384 + i, 0);
            let i = i + 1;
        }
        return;
    }

    /** Sets the current color for drawing: black = true, white = false. */
    function void setColor(boolean b) {
        let color = b;
        return;
    }

    /** Draws the (x,y) pixel using the current color. */
    function void drawPixel(int x, int y) {
        var int address, mask, value;
        let address = 16384 + (y * 32) + (x / 16);
        let mask = twoToThe[x & 15]; // x & 15 is equivalent to x mod 16
        let value = Memory.peek(address);
        if (color) {
            let value = value | mask;
        }
        else {
            let value = value & (~mask);
        }
        do Memory.poke(address, value);
        return;
    }

    /** Draws a line from pixel (x1,y1) to pixel (x2,y2) using the current color. */
    function void drawLine(int x1, int y1, int x2, int y2) {
        var int dx, dy, a, b, diff, temp;
        var int stepX, stepY;

        // Horizontal line optimisation
        if (y1 = y2) {
            if (x1 > x2) {
                let temp = x1;
                let x1 = x2;
                let x2 = temp;
            }
            do Screen.drawHorizontalLine(x1, x2, y1);
            return;
        }

        // Vertical line optimisation
        if (x1 = x2) {
            if (y1 > y2) {
                let temp = y1;
                let y1 = y2;
                let y2 = temp;
            }
            while (~(y1 > y2)) {
                do Screen.drawPixel(x1, y1);
                let y1 = y1 + 1;
            }
            return;
        }

        // General case: Bresenham-style
        let dx = Math.abs(x2 - x1);
        let dy = Math.abs(y2 - y1);

        if (x1 < x2) { let stepX = 1; } else { let stepX = -1; }
        if (y1 < y2) { let stepY = 1; } else { let stepY = -1; }

        let a = 0;
        let b = 0;
        let diff = 0;

        while (~(a > dx) & ~(b > dy)) {
            do Screen.drawPixel(x1 + (a * stepX), y1 + (b * stepY));
            if (diff < 0) {
                let a = a + 1;
                let diff = diff + dy;
            }
            else {
                let b = b + 1;
                let diff = diff - dx;
            }
        }
        return;
    }

    /** Draws a horizontal line from x1 to x2 at row y. Optimised to write full words. */
    function void drawHorizontalLine(int x1, int x2, int y) {
        var int startAddr, endAddr, x1mod, x2mod;
        var int addr, mask, value;

        // If within the same word, just draw pixel by pixel
        if ((x1 / 16) = (x2 / 16)) {
            while (~(x1 > x2)) {
                do Screen.drawPixel(x1, y);
                let x1 = x1 + 1;
            }
            return;
        }

        // Draw left partial word
        let x1mod = x1 & 15;
        if (~(x1mod = 0)) {
            while (~(x1mod > 15)) {
                do Screen.drawPixel(x1, y);
                let x1 = x1 + 1;
                let x1mod = x1mod + 1;
            }
        }

        // Draw full words in the middle
        let startAddr = 16384 + (y * 32) + (x1 / 16);
        let endAddr = 16384 + (y * 32) + (x2 / 16);
        let addr = startAddr;
        while (addr < endAddr) {
            if (color) {
                do Memory.poke(addr, -1); // -1 is 1111111111111111 in 2's complement
            }
            else {
                do Memory.poke(addr, 0);
            }
            let addr = addr + 1;
        }

        // Draw right partial word
        let x2mod = x2 & 15;
        let x1 = x2 - x2mod;
        while (~(x1 > x2)) {
            do Screen.drawPixel(x1, y);
            let x1 = x1 + 1;
        }

        return;
    }

    /** Draws a filled rectangle whose top left corner is (x1,y1)
     *  and bottom right corner is (x2,y2) using the current color. */
    function void drawRectangle(int x1, int y1, int x2, int y2) {
        while (~(y1 > y2)) {
            do Screen.drawHorizontalLine(x1, x2, y1);
            let y1 = y1 + 1;
        }
        return;
    }

    /** Draws a filled circle of radius r <= 181 around (x,y) using the current color. */
    function void drawCircle(int x, int y, int r) {
        var int dy, rSquared, halfWidth;

        if (r > 181) { let r = 181; } // Prevent overflow

        let rSquared = r * r;
        let dy = -r;
        while (~(dy > r)) {
            let halfWidth = Math.sqrt(rSquared - (dy * dy));
            do Screen.drawHorizontalLine(x - halfWidth, x + halfWidth, y + dy);
            let dy = dy + 1;
        }
        return;
    }
}
