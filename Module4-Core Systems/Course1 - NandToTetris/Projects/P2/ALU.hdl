// File name: projects/2/ALU.hdl
/**
 * ALU (Arithmetic Logic Unit):
 * Computes out = one of the following functions:
 *                0, 1, -1,
 *                x, y, !x, !y, -x, -y,
 *                x + 1, y + 1, x - 1, y - 1,
 *                x + y, x - y, y - x,
 *                x & y, x | y
 * on the 16-bit inputs x, y,
 * according to the input bits zx, nx, zy, ny, f, no.
 * In addition, computes the two output bits:
 * if (out == 0) zr = 1, else zr = 0
 * if (out < 0)  ng = 1, else ng = 0
 */
// Implementation: Manipulates the x and y inputs
// and operates on the resulting values, as follows:
// if (zx == 1) sets x = 0        // 16-bit constant
// if (nx == 1) sets x = !x       // bitwise not
// if (zy == 1) sets y = 0        // 16-bit constant
// if (ny == 1) sets y = !y       // bitwise not
// if (f == 1)  sets out = x + y  // integer 2's complement addition
// if (f == 0)  sets out = x & y  // bitwise and
// if (no == 1) sets out = !out   // bitwise not

CHIP ALU {
    IN  
        x[16], y[16],  // 16-bit inputs        
        zx, // zero the x input?
        nx, // negate the x input?
        zy, // zero the y input?
        ny, // negate the y input?
        f,  // compute (out = x + y) or (out = x & y)?
        no; // negate the out output?
    OUT 
        out[16], // 16-bit output
        zr,      // if (out == 0) equals 1, else 0
        ng;      // if (out < 0)  equals 1, else 0

    PARTS:
    //// Replace this comment with your code
    //Let's build each of the gates step by step
    //Gate1 - Will take x and make all its digits0 , we can just use a Mux here
    Mux16(a= x, b= false, sel= zx, out= outzx);
    //Gate2 - if nx is 1, then we invert outzx, else it will remain as is
    Not16(in= outzx, out= notoutzx); //We will have 2 inputs of Mux
    Mux16(a= outzx, b= notoutzx, sel= nx, out= outnx);
    //Lets do the same for y now
    //Gate3 - Again we will take a mux for putting y = 0 if zy = 1
    Mux16(a=y , b= false, sel= zy , out= outzy );
    //Gate4 - Again we will first have an inverted input of y, and then run it pass a mux
    Not16(in= outzy, out= notoutzy);
    Mux16(a= outzy, b= notoutzy, sel= ny, out= outny);
    //Gate5 - we will create 2 inouts, one for add16, and one for And16, and then pass it through a mux
    Add16(a= outnx, b= outny, out= addxy);
    And16(a= outnx, b= outny, out= andxy );
    Mux16(a= andxy, b= addxy, sel= f, out= foutxy);
    //Gate6 - Finally we negate the output if no is true
    //We again create a not output for foutxy and then pass it through. a mux
    Not16(in= foutxy , out= notfoutxy);
    Mux16(a= foutxy, b= notfoutxy, sel= no, out= tempout, out[15] = bit15, out[14] = bit14, out[13] = bit13, out[12] = bit12, out[11] = bit11, out[10] = bit10, out[9] = bit9, out[8] = bit8, out[7] = bit7, out[6] = bit6, out[5] = bit5, out[4] = bit4, out[3] = bit3, out[2] = bit2, out[1] = bit1, out[0] = bit0);
    And16(a= tempout, b= true, out= out, out[15] = ng); //Here we are getting the negative flag
    
    //Gate 7 - To get zero flag is a bit tricky
    //We will need to take NOR of each bit of out with the rest of the bits, basically a 16 way nor gate
    Or(a= bit0, b=bit1 , out= or1);
    Or(a= bit2, b=or1 , out= or2);
    Or(a= bit3, b=or2 , out= or3);
    Or(a= bit4, b=or3 , out= or4);
    Or(a= bit5, b=or4 , out= or5);
    Or(a= bit6, b=or5 , out= or6);
    Or(a= bit7, b=or6 , out= or7);
    Or(a= bit8, b=or7 , out= or8);
    Or(a= bit9, b=or8 , out= or9);
    Or(a= bit10, b=or9 , out= or10);
    Or(a= bit11, b=or10 , out= or11);
    Or(a= bit12, b=or11 , out= or12);
    Or(a= bit13, b=or12 , out= or13);
    Or(a= bit14, b=or13 , out= or14);
    Or(a= bit15, b=or14 , out= or15);
    Not(in= or15, out= zr);
    


    

}