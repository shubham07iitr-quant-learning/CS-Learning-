/**
 * 16-bit incrementer:
 * out = in + 1
 */
CHIP Inc16 {
    IN in[16];
    OUT out[16];

    PARTS:
    //// Replace this comment with your code.
    //We will have to build each of the components separately here
    //16 full adders with first adder taking in 1 and remaining taking in 0 for b
    FullAdder(a= in[0], b= true, c= false, sum= out[0], carry= tempcarry1);
    FullAdder(a= in[1], b= false, c= tempcarry1, sum= out[1], carry= tempcarry2);
    FullAdder(a= in[2], b= false, c= tempcarry2, sum= out[2], carry= tempcarry3);
    FullAdder(a= in[3], b= false, c= tempcarry3, sum= out[3], carry= tempcarry4);
    FullAdder(a= in[4], b= false, c= tempcarry4, sum= out[4], carry= tempcarry5);
    FullAdder(a= in[5], b= false, c= tempcarry5, sum= out[5], carry= tempcarry6);
    FullAdder(a= in[6], b= false, c= tempcarry6, sum= out[6], carry= tempcarry7);
    FullAdder(a= in[7], b= false, c= tempcarry7, sum= out[7], carry= tempcarry8);
    FullAdder(a= in[8], b= false, c= tempcarry8, sum= out[8], carry= tempcarry9);
    FullAdder(a= in[9], b= false, c= tempcarry9, sum= out[9], carry= tempcarry10);
    FullAdder(a= in[10], b= false, c= tempcarry10, sum= out[10], carry= tempcarry11);
    FullAdder(a= in[11], b= false, c= tempcarry11, sum= out[11], carry= tempcarry12);
    FullAdder(a= in[12], b= false, c= tempcarry12, sum= out[12], carry= tempcarry13);
    FullAdder(a= in[13], b= false, c= tempcarry13, sum= out[13], carry= tempcarry14);
    FullAdder(a= in[14], b= false, c= tempcarry14, sum= out[14], carry= tempcarry15);
    FullAdder(a= in[15], b= false, c= tempcarry15, sum= out[15], carry= tempcarry16);
}