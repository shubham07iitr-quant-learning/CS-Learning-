// File name: projects/3/b/RAM16K.hdl
/**
 * Memory of 16K 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM16K {
    IN in[16], load, address[14];
    OUT out[16];

    PARTS:
    //// Replace this comment with your code.
    //Same idea as before, we construct 4 separate RAM4K , and then use 2 bits for addressing 4 separate RAM4Ks, and remaining 12 bits for each of the separate RAM4Ks
    //Gate1 - 4 way demux to get the right load for each of the separate 4 RAM4Ks
    DMux4Way(in= load , sel= address[0..1], a=loada , b= loadb , c= loadc , d= loadd);
    //Now we create 4 separae RAM512s
    RAM4K(in= in, load= loada, address= address[2..13], out= outa);
    RAM4K(in= in, load= loadb, address= address[2..13], out= outb);
    RAM4K(in= in, load= loadc, address= address[2..13], out= outc);
    RAM4K(in= in, load= loadd, address= address[2..13], out= outd);

    //GATE3 - And finally we create GATE3 for selecting hte right output
    Mux4Way16(a= outa, b= outb, c= outc, d= outd, sel= address[0..1], out= out);
}